# Development only. Use a long, random DATABASE_URL credential in production.
DATABASE_URL=sqlite:///./data/heart_non_pro.db
AVATAR_DIRECTORY=./data/avatars

# Comma-separated Webflow site origins. Do not use * when cookies are enabled.
CORS_ORIGINS=https://your-site.webflow.io,https://www.your-domain.example

# Local HTTP development: false + lax. Production HTTPS: true + none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Put the IP addresses of a trusted reverse proxy here when it forwards X-Forwarded-For.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional local MaxMind GeoLite2 City database. Without it, location is shown as unavailable.
GEOLITE_CITY_DATABASE=./data/GeoLite2-City.mmdb
